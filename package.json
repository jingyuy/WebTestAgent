{
  "name": "web-test-agent",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness browser bundle: accessibility-snapshot interaction with stable element refs, shipped as @webtestagent/dsh-browser-playwright.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:plugin": "npm run build --workspace @webtestagent/dsh-browser-playwright",
    "typecheck:plugin": "npm run typecheck --workspace @webtestagent/dsh-browser-playwright",
    "test:plugin": "npm run test:e2e --workspace @webtestagent/dsh-browser-playwright",
    "manual:plugin": "npm run manual:challenge --workspace @webtestagent/dsh-browser-playwright",
    "install:plugin": "node scripts/install-dsh-plugin.mjs"
  }
}
