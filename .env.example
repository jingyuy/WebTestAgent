# --- Browser ---
# Launch Chromium headless by default. Set to false to watch the run.
HEADLESS=true
# Record a .webm video of every run.
RECORD_VIDEO=true
# Optional: slow every Playwright action down by N ms (useful when watching).
SLOW_MO=0

# --- Demo app ---
# Port the bundled demo app is expected to be served on.
PORT=3000

# --- Model (consumed by DeepSeek Harness, not by this repo) ---
# The harness reads its credentials from the *launching environment*, so export
# this when you invoke `dsh`, e.g.
#   DEEPSEEK_API_KEY=$(grep -m1 '^DEEPSEEK_API_KEY=' .env | cut -d= -f2-) \
#     npx @deepseek-ai/dsh@0.1.5-rc.2 --profile headless "<task>"
#
# Do NOT add DEEPSEEK_BASE_URL or DEEPSEEK_MODEL here: dsh refuses to boot when
# a project-local .env points the base URL elsewhere (an anti-hijack fence).
DEEPSEEK_API_KEY=sk-your-key-here
