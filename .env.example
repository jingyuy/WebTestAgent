# --- LLM (DeepSeek uses an OpenAI-compatible chat completions API) ---
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Server ---
PORT=3000

# --- Browser ---
# Launch Chromium headless by default. Set to false to watch the run.
HEADLESS=true
# Record a .webm video of every run.
RECORD_VIDEO=true
# Optional: slow every Playwright action down by N ms (useful when watching).
SLOW_MO=0
# Hard cap on agent steps per run.
MAX_STEPS=40
