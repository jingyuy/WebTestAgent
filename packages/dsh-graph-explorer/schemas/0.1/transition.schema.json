{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integration-test-generator.local/schemas/0.1/transition.schema.json",
  "title": "Transition",
  "description": "A meaningful change in application behaviour. The core unit of behaviour: a test is a sequence of transitions, and an assertion is a claim about their effects.",
  "type": "object",
  "required": ["id", "from_state", "to_state", "action"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/transitionId" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "from_state": {
      "description": "Source state, a list of source states, or \"*\" when the transition is available from anywhere (logout, open-cart).",
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/stateIdOrWildcard" },
        {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/stateId" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "to_state": {
      "$ref": "common.schema.json#/$defs/stateId",
      "description": "Destination state. Must be concrete and may equal from_state for a self-loop (re-render, retry, validation failure)."
    },
    "action": {
      "type": "object",
      "description": "The user/business intent that triggers the transition.",
      "required": ["capability"],
      "properties": {
        "capability": { "$ref": "common.schema.json#/$defs/capabilityId" },
        "arguments": {
          "type": "object",
          "description": "Concrete argument values used for this transition, e.g. {coupon_code: 'SAVE10'}.",
          "additionalProperties": true
        },
        "target": {
          "$ref": "common.schema.json#/$defs/elementId",
          "description": "Element the user acted on, when the capability is not bound to a single element."
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "guard": {
      "type": "string",
      "description": "Condition that must hold for this transition to be taken, e.g. cart.item_count > 0."
    },
    "preconditions": { "$ref": "common.schema.json#/$defs/preconditionList" },
    "effects": {
      "type": "array",
      "description": "What changed as a result. Prefer semantic paths (order.total) over DOM selectors.",
      "items": { "$ref": "#/$defs/effect" }
    },
    "assertions": {
      "$ref": "common.schema.json#/$defs/assertionList",
      "description": "Checks that should hold after this transition, used when generating a test step."
    },
    "apis": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/apiId" },
      "uniqueItems": true,
      "description": "Network calls this transition triggers."
    },
    "source_mappings": { "$ref": "common.schema.json#/$defs/sourceMappingList" },
    "evidence": { "$ref": "common.schema.json#/$defs/evidenceList" },
    "tags": { "$ref": "common.schema.json#/$defs/tagList" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" }
  },
  "additionalProperties": false,
  "$defs": {
    "effect": {
      "type": "object",
      "description": "An observed or inferred consequence of a transition. Required fields depend on `type`.",
      "required": ["type"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "type": {
          "type": "string",
          "enum": [
            "value_changed",
            "visibility_changed",
            "navigation",
            "url_changed",
            "state_entered",
            "message",
            "request",
            "storage_changed",
            "validation_error",
            "element_created",
            "element_destroyed",
            "list_changed",
            "custom"
          ],
          "description": "value_changed: a semantic value differs. visibility_changed: element shown/hidden/enabled/disabled. navigation: a page was entered. url_changed: URL mutated without navigation. state_entered: graph state entered. message: user-facing feedback. request: an API call happened. storage_changed: cookie/localStorage/session. validation_error: input rejected. element_created/element_destroyed: DOM-level evidence of a structural change. list_changed: collection membership/order changed."
        },
        "target": {
          "type": "string",
          "description": "Semantic path (order.total), element id (element_cart_badge) or storage key."
        },
        "from": { "description": "Value before the transition. Omit when unknown." },
        "to": { "description": "Value after the transition." },
        "value": { "description": "Value for effects that have no 'before', e.g. message text." },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "api": { "$ref": "common.schema.json#/$defs/apiId" },
        "state": { "$ref": "common.schema.json#/$defs/stateId" },
        "element": { "$ref": "common.schema.json#/$defs/elementId" },
        "operation": {
          "type": "string",
          "enum": ["add", "remove", "reorder", "reset"],
          "description": "For list_changed."
        },
        "observed": {
          "type": "boolean",
          "description": "true when the effect was seen in evidence, false when it was inferred from code. Inferred effects must carry confidence in metadata."
        },
        "description": { "type": "string" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidenceList" }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "value_changed" } } },
          "then": { "$ref": "#/$defs/requireTargetAndTo" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "visibility_changed" } } },
          "then": { "$ref": "#/$defs/requireTargetAndTo" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "navigation" } } },
          "then": { "$ref": "#/$defs/requireTo" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "url_changed" } } },
          "then": { "$ref": "#/$defs/requireTo" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "state_entered" } } },
          "then": { "$ref": "#/$defs/requireTo" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "message" } } },
          "then": { "$ref": "#/$defs/requireMessage" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "request" } } },
          "then": { "$ref": "#/$defs/requireApi" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "storage_changed" } } },
          "then": { "$ref": "#/$defs/requireTarget" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "validation_error" } } },
          "then": { "$ref": "#/$defs/requireTarget" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "element_created" } } },
          "then": { "$ref": "#/$defs/requireTarget" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "element_destroyed" } } },
          "then": { "$ref": "#/$defs/requireTarget" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "list_changed" } } },
          "then": { "$ref": "#/$defs/requireTarget" }
        }
      ],
      "additionalProperties": false
    },
    "requireTargetAndTo": {
      "type": "object",
      "required": ["target", "to"],
      "properties": {
        "type": { "type": "string" },
        "target": { "type": "string" },
        "to": {}
      }
    },
    "requireTo": {
      "type": "object",
      "required": ["to"],
      "properties": {
        "type": { "type": "string" },
        "to": {}
      }
    },
    "requireMessage": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "requireApi": {
      "type": "object",
      "required": ["api"],
      "properties": {
        "type": { "type": "string" },
        "api": { "type": "string" }
      }
    },
    "requireTarget": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "type": { "type": "string" },
        "target": { "type": "string" }
      }
    }
  }
}
